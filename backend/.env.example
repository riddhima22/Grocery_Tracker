# Django Configuration
SECRET_KEY=django-insecure-change-this-in-production-key-value-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
DATABASE_URL=sqlite:///db.sqlite3

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
AI_PROVIDER_ORDER=gemini,openai
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash
GEMINI_RECIPE_MODEL_NAME=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# Google Cloud Vision OCR Configuration
# Path to GCP Service Account JSON key file (requires Cloud Vision API enabled)
GOOGLE_APPLICATION_CREDENTIALS=
OCR_ENABLED=True
OCR_PROVIDER=TEXT_DETECTION

# Scanning limits
AI_BLUR_VARIANCE_THRESHOLD=100.0

# Open Food Facts
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
